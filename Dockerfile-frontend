# ============================================
# Stage 1: Builder
# ============================================
FROM node:24-alpine AS builder

WORKDIR /app

# Enable pnpm via Corepack
RUN corepack enable

# Copy dependency manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml nx.json tsconfig.base.json ./

# Install workspace dependencies
RUN pnpm install --frozen-lockfile

# Copy source code and config files
COPY . .

# Build all 4 frontend applications
RUN pnpm nx run-many -t build -p psb santri merchant admin

# ============================================
# Stage 2: Runtime
# ============================================
FROM nginx:alpine AS runner

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy build artifacts for each frontend application
COPY --from=builder /app/dist/apps/psb /usr/share/nginx/html/psb
COPY --from=builder /app/dist/apps/santri /usr/share/nginx/html/santri
COPY --from=builder /app/dist/apps/merchant /usr/share/nginx/html/merchant
COPY --from=builder /app/dist/apps/admin /usr/share/nginx/html/admin

# Port 8080 for Google Cloud Run
EXPOSE 8080

# Run Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
